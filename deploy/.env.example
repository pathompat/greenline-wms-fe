# ---------------------------------------------------------------------------
# Server-side environment for ./docker-compose.yml.
# Copy to deploy/.env on the VM:
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# deploy/.env is git-ignored and is NEVER written by the pipeline — the pipeline
# only reads it. It is optional: every key here has a working default, and the
# pipeline passes the image tag and VITE_API_URL in the environment (which compose
# ranks above every --env-file), so a deploy works with no file at all.
# ---------------------------------------------------------------------------

# ---- Shared network ---------------------------------------------------------
# The backend is a separate compose project in its own repository. The two are
# joined only by this network, which is `external` in both compose files: either
# stack can be brought up, torn down or redeployed without the other. Both
# pipelines create it if it is missing.
#
#   docker network create greenline-net
NETWORK_NAME=greenline-net

# ---- Image ------------------------------------------------------------------
# Built locally on this VM by the pipeline's build stage. WEB_IMAGE_TAG here is
# only a fallback: the deploy stage passes the tag it actually tested. The
# container name is what the backend's edge nginx proxies to (its WEB_UPSTREAM,
# default greenline-wms-web:80) and what the deploy job health-checks — rename it
# in both places or not at all.
WEB_IMAGE=greenline-wms-web
WEB_IMAGE_TAG=latest
WEB_CONTAINER=greenline-wms-web

# ---- Published port ---------------------------------------------------------
# Loopback-only: the edge reaches this container over the shared network, so this
# is only for checking the app from the VM itself. WEB_BIND=0.0.0.0 serves it
# directly to the internet, which is what you want if you run this stack with no
# backend edge in front of it.
WEB_BIND=127.0.0.1
WEB_HOST_PORT=8080

# ---- Build ------------------------------------------------------------------
# Vite INLINES this into the bundle at build time, so the image is specific to one
# origin: changing it requires a rebuild, not a restart. It is the API's *origin*
# only — the app appends /api/... itself.
#
#   ✅ https://dev-app.greenlinepetcare.co.th
#   ❌ https://dev-app.greenlinepetcare.co.th/       trailing slash
#   ❌ https://dev-app.greenlinepetcare.co.th/api    the app adds /api itself
#
# Since the edge serves this app and proxies /api/ on the same host, it is the
# site's own public URL — and it must be https:// once TLS is on, or the browser
# blocks the calls as mixed content.
#
# The pipeline reads this from the `VITE_API_URL` GitHub variable and passes it in
# the environment; this copy only matters when you build by hand on the VM.
VITE_API_URL=https://dev-app.greenlinepetcare.co.th

# ---- Pipeline ---------------------------------------------------------------
# How many old greenline-wms-web:<sha> images to keep on the VM.
KEEP_IMAGES=5
